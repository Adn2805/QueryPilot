# Database
DATABASE_URL=postgresql+asyncpg://querypilot:querypilot_password@localhost:5432/querypilot_app
ANALYTICS_DATABASE_URL=postgresql+asyncpg://querypilot_readonly:readonly_password@localhost:5432/querypilot_analytics
POSTGRES_USER=querypilot
POSTGRES_PASSWORD=querypilot_password
POSTGRES_DB=querypilot_app
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Auth
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# App
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Query Limits
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
MAX_REPAIR_ATTEMPTS=3

# Currency (configurable)
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
